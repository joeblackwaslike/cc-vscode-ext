# The extension host code is bundled into dist/extension.js, and the webview
# into webview/, so none of the source/build inputs need to ship.
src/**
webview-src/**
out/**
**/*.map
**/*.ts

# The pinned claude binary is downloaded into global storage on first run
# (src/process/ClaudeBinary.ts) — it must NOT be bundled. A stale local copy
# under resources/native-binary/ would otherwise bloat the .vsix by ~200 MB.
# (No `!resources/**` negation here: vsce gives `!` precedence over ignores
# regardless of order, which would force the binary back in. Nothing else
# ignores the svg/png/md under resources/, so they ship by default.)
resources/native-binary/**

# Tests & their artifacts
test/**
test-results/**
playwright-report/**
.vscode-test/**
playwright.e2e.config.ts
vitest.config.ts

# Dev tooling, caches, and the vendored reference copy of the real extension
.serena/**
vendor/**
scripts/**
.vscode/**
.vscode-test.mjs
.github/**
.clawhip/**
.git/**
node_modules/**
.worktrees/**

# Personal task-tracking data and internal planning docs — never ship these.
.beads/**
docs/**

# Build configs / linting
esbuild.config.js
vite.config.ts
tsconfig*.json
eslint.config.js
.eslintrc*
.eslint*
.prettier*
.editorconfig
.gitignore
.gitattributes
cc-vscode-ext.code-workspace

# Kept (NOT ignored): dist/, webview/, resources/ (icons, walkthrough — but NOT
# native-binary/, which is downloaded on first run), package.json,
# README/LICENSE/CHANGELOG.
