{
  "name": "clawd-code",
  "displayName": "Clawd Code",
  "description": "A clean, documented reimplementation of the Claude Code VS Code extension",
  "version": "0.3.0",
  "publisher": "joeblackwaslike",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joeblackwaslike/cc-vscode-ext.git"
  },
  "homepage": "https://github.com/joeblackwaslike/cc-vscode-ext#readme",
  "bugs": {
    "url": "https://github.com/joeblackwaslike/cc-vscode-ext/issues"
  },
  "claudeCliVersion": "2.1.237",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "ai",
    "mcp",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:clawdVSCodePanel"
  ],
  "icon": "resources/clawd-icon.png",
  "main": "./dist/extension.js",
  "scripts": {
    "build:ext": "node esbuild.config.js",
    "build:webview": "vite build --config vite.config.ts",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.config.js --watch",
    "watch:webview": "vite build --watch --config vite.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:webview": "vitest run --config vitest.webview.config.ts",
    "test:webview:watch": "vitest --config vitest.webview.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:raw": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:debug": "PWDEBUG=1 playwright test --config playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config playwright.e2e.config.ts --ui",
    "test:all": "bash scripts/test-all.sh",
    "build:integration": "tsc -p tsconfig.integrationtest.json",
    "test:integration": "npm run build && npm run build:integration && vscode-test",
    "test": "npm run test:unit",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:webview": "tsc --noEmit -p tsconfig.webview.json",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "install:insiders": "bash scripts/install-insiders.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "contributes": {
    "configuration": [
      {
        "title": "Clawd Code",
        "properties": {
          "clawdCode.enableNewConversationShortcut": {
            "type": "boolean",
            "default": false,
            "description": "Enable the Cmd+N (Ctrl+N) shortcut to create a new conversation"
          },
          "clawdCode.enableReopenClosedSessionShortcut": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Cmd+Shift+T (Ctrl+Shift+T) shortcut to reopen closed sessions"
          },
          "clawdCode.customModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Additional model IDs to show in the model picker (e.g. \"claude-opus-4-7\")."
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.claude/settings.json",
          "**/.claude/settings.local.json",
          "**/ClaudeCode/managed-settings.json",
          "**/claude-code/managed-settings.json"
        ],
        "url": "./claude-code-settings.schema.json"
      }
    ],
    "commands": [
      {
        "command": "clawd-vscode.editor.open",
        "title": "Clawd Code: Open in New Tab",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "clawd-vscode.editor.openLast",
        "title": "Clawd Code: Open",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "clawd-vscode.primaryEditor.open",
        "title": "Clawd Code: Open in Primary Editor",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "clawd-vscode.window.open",
        "title": "Clawd Code: Open in New Window"
      },
      {
        "command": "clawd-vscode.createWorktree",
        "title": "Clawd Code: Create Worktree"
      },
      {
        "command": "clawd-vscode.sidebar.open",
        "title": "Clawd Code: Open in Side Bar",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "clawd-vscode.newConversation",
        "title": "Clawd Code: New Conversation"
      },
      {
        "command": "clawd-vscode.reopenClosedSession",
        "title": "Clawd Code: Reopen Closed Session"
      },
      {
        "command": "clawd-vscode.update",
        "title": "Clawd Code: Update extension"
      },
      {
        "command": "clawd-vscode.focus",
        "title": "Clawd Code: Focus input"
      },
      {
        "command": "clawd-vscode.blur",
        "title": "Clawd Code: Blur input"
      },
      {
        "command": "clawd-vscode.logout",
        "title": "Clawd Code: Logout"
      },
      {
        "command": "clawd-vscode.terminal.open",
        "title": "Clawd Code: Open in Terminal",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "clawd-vscode.acceptProposedDiff",
        "title": "Clawd Code: Accept Proposed Changes",
        "enablement": "clawd-vscode.viewingProposedDiff",
        "icon": "$(check)"
      },
      {
        "command": "clawd-vscode.rejectProposedDiff",
        "title": "Clawd Code: Reject Proposed Changes",
        "enablement": "clawd-vscode.viewingProposedDiff",
        "icon": "$(discard)"
      },
      {
        "command": "clawd-vscode.insertAtMention",
        "title": "Clawd Code: Insert @-Mention Reference"
      },
      {
        "command": "clawd-vscode.installPlugin",
        "title": "Clawd Code: Install Plugin"
      },
      {
        "command": "clawd-vscode.showLogs",
        "title": "Clawd Code: Show Logs"
      },
      {
        "command": "clawd-vscode.openWalkthrough",
        "title": "Clawd Code: Open Walkthrough"
      },
      {
        "command": "clawd-vscode.toggleFocusView",
        "title": "Clawd Code: Toggle Focus View"
      }
    ],
    "keybindings": [
      {
        "command": "clawd-vscode.insertAtMention",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "clawd-vscode.focus",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "!config.claudeCode.useTerminal && editorTextFocus"
      },
      {
        "command": "clawd-vscode.blur",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "!config.claudeCode.useTerminal && !editorTextFocus"
      },
      {
        "command": "clawd-vscode.editor.open",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape",
        "when": "!config.claudeCode.useTerminal"
      },
      {
        "command": "clawd-vscode.terminal.open.keyboard",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "config.claudeCode.useTerminal"
      },
      {
        "command": "clawd-vscode.insertAtMention",
        "key": "cmd+alt+K",
        "mac": "cmd+alt+K",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K",
        "when": "editorTextFocus"
      },
      {
        "command": "clawd-vscode.newConversation",
        "key": "cmd+n",
        "mac": "cmd+n",
        "win": "ctrl+n",
        "linux": "ctrl+n",
        "when": "config.clawdCode.enableNewConversationShortcut && (activeWebviewPanelId == 'clawdVSCodePanel' || (clawd-vscode.sideBarActive && !editorFocus && !panelFocus))"
      },
      {
        "command": "clawd-vscode.reopenClosedSession",
        "key": "cmd+shift+t",
        "mac": "cmd+shift+t",
        "win": "ctrl+shift+t",
        "linux": "ctrl+shift+t",
        "when": "config.clawdCode.enableReopenClosedSessionShortcut && clawd-vscode.lastClosedWasSession"
      },
      {
        "command": "clawd-vscode.toggleFocusView",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "activeWebviewPanelId == 'clawdVSCodePanel' || (clawd-vscode.sideBarActive && !editorFocus && !panelFocus)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clawd-sidebar",
          "title": "Clawd Code",
          "icon": "resources/clawd.svg",
          "when": "clawd-code:doesNotSupportSecondarySidebar"
        },
        {
          "id": "clawd-sessions-sidebar",
          "title": "Clawd Code",
          "icon": "resources/clawd.svg",
          "when": "clawd-vscode.sessionsListEnabled"
        }
      ],
      "secondarySidebar": [
        {
          "id": "clawd-sidebar-secondary",
          "title": "Clawd Code",
          "icon": "resources/clawd.svg",
          "when": "!clawd-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "clawd-sidebar": [
        {
          "type": "webview",
          "id": "clawdVSCodeSidebar",
          "name": "Clawd Code",
          "when": "clawd-code:doesNotSupportSecondarySidebar"
        }
      ],
      "clawd-sidebar-secondary": [
        {
          "type": "webview",
          "id": "clawdVSCodeSidebarSecondary",
          "name": "Clawd Code",
          "when": "!clawd-code:doesNotSupportSecondarySidebar"
        }
      ],
      "clawd-sessions-sidebar": [
        {
          "type": "webview",
          "id": "clawdVSCodeSessionsList",
          "name": "",
          "when": "clawd-vscode.sessionsListEnabled"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "clawd-code-walkthrough",
        "title": "Get started with Claude Code",
        "description": "Learn how to use Claude Code to write, edit, and understand your code.",
        "steps": [
          {
            "id": "welcome",
            "title": "Your AI coding partner",
            "description": "Claude Code helps you write, edit, and understand code right in VS Code.",
            "media": {
              "markdown": "resources/walkthrough/step1.md"
            }
          },
          {
            "id": "open-claude",
            "title": "Open Claude Code",
            "description": "Click the orange Claude icon in the top right corner, or press Ctrl+Escape (Cmd+Escape on Mac) to start a conversation.",
            "media": {
              "markdown": "resources/walkthrough/step2.md"
            },
            "completionEvents": [
              "onCommand:clawd-vscode.sidebar.open",
              "onCommand:clawd-vscode.editor.open"
            ]
          },
          {
            "id": "chat",
            "title": "Chat with Claude",
            "description": "Type a message and press Enter. Ask questions, request changes, or get help understanding your code. Use @ to mention files for context, or select code first to ask about it.",
            "media": {
              "markdown": "resources/walkthrough/step3.md"
            }
          },
          {
            "id": "sessions",
            "title": "Past conversations",
            "description": "Click the Past Conversations button at the top or type /resume to browse past sessions. You can start a new conversation anytime by clicking the New Chat button.",
            "media": {
              "markdown": "resources/walkthrough/step4.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "clawd-vscode.acceptProposedDiff",
          "when": "clawd-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "clawd-vscode.rejectProposedDiff",
          "when": "clawd-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "clawd-vscode.editor.openLast",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation"
        },
        {
          "command": "clawd-vscode.terminal.open",
          "when": "config.claudeCode.useTerminal",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "clawd-vscode.update",
          "when": "clawd-vscode.updateSupported"
        },
        {
          "command": "clawd-vscode.editor.openLast",
          "when": "false"
        },
        {
          "command": "clawd-vscode.primaryEditor.open",
          "when": "clawd-vscode.primaryEditorEnabled"
        },
        {
          "command": "clawd-vscode.createWorktree",
          "when": "clawd-vscode.createWorktreeEnabled"
        },
        {
          "command": "clawd-vscode.blur",
          "when": "false"
        },
        {
          "command": "clawd-vscode.newConversation",
          "when": "false"
        },
        {
          "command": "clawd-vscode.insertAtMention"
        },
        {
          "command": "clawd-vscode.installPlugin",
          "when": "clawd-vscode.updateSupported"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Untrusted workspaces are not supported"
    }
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0"
  }
}
