{
  "name": "claw-code",
  "displayName": "Claw Code",
  "description": "A clean, documented reimplementation of the Claude Code VS Code extension",
  "version": "0.1.0",
  "publisher": "reference",
  "license": "MIT",
  "claudeCliVersion": "2.1.168",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "ai",
    "mcp",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:clawVSCodePanel"
  ],
  "icon": "resources/claude-logo.png",
  "main": "./dist/extension.js",
  "scripts": {
    "build:ext": "node esbuild.config.js",
    "build:webview": "vite build --config vite.config.ts",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.config.js --watch",
    "watch:webview": "vite build --watch --config vite.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:webview": "vitest run --config vitest.webview.config.ts",
    "test:webview:watch": "vitest --config vitest.webview.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:raw": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:debug": "PWDEBUG=1 playwright test --config playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config playwright.e2e.config.ts --ui",
    "test:all": "bash scripts/test-all.sh",
    "build:integration": "tsc -p tsconfig.integrationtest.json",
    "test:integration": "npm run build && npm run build:integration && vscode-test",
    "test": "npm run test:unit",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:webview": "tsc --noEmit -p tsconfig.webview.json",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "install:insiders": "bash scripts/install-insiders.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.claude/settings.json",
          "**/.claude/settings.local.json",
          "**/ClaudeCode/managed-settings.json",
          "**/claude-code/managed-settings.json"
        ],
        "url": "./claude-code-settings.schema.json"
      }
    ],
    "commands": [
      {
        "command": "claw-vscode.editor.open",
        "title": "Claw Code: Open in New Tab",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "claw-vscode.editor.openLast",
        "title": "Claw Code: Open",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "claw-vscode.primaryEditor.open",
        "title": "Claw Code: Open in Primary Editor",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "claw-vscode.window.open",
        "title": "Claw Code: Open in New Window"
      },
      {
        "command": "claw-vscode.createWorktree",
        "title": "Claw Code: Create Worktree"
      },
      {
        "command": "claw-vscode.sidebar.open",
        "title": "Claw Code: Open in Side Bar",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "claw-vscode.newConversation",
        "title": "Claw Code: New Conversation"
      },
      {
        "command": "claw-vscode.reopenClosedSession",
        "title": "Claw Code: Reopen Closed Session"
      },
      {
        "command": "claw-vscode.update",
        "title": "Claw Code: Update extension"
      },
      {
        "command": "claw-vscode.focus",
        "title": "Claw Code: Focus input"
      },
      {
        "command": "claw-vscode.blur",
        "title": "Claw Code: Blur input"
      },
      {
        "command": "claw-vscode.logout",
        "title": "Claw Code: Logout"
      },
      {
        "command": "claw-vscode.terminal.open",
        "title": "Claw Code: Open in Terminal",
        "icon": {
          "light": "resources/clawd.svg",
          "dark": "resources/clawd.svg"
        }
      },
      {
        "command": "claw-vscode.acceptProposedDiff",
        "title": "Claw Code: Accept Proposed Changes",
        "enablement": "claw-vscode.viewingProposedDiff",
        "icon": "$(check)"
      },
      {
        "command": "claw-vscode.rejectProposedDiff",
        "title": "Claw Code: Reject Proposed Changes",
        "enablement": "claw-vscode.viewingProposedDiff",
        "icon": "$(discard)"
      },
      {
        "command": "claw-vscode.insertAtMention",
        "title": "Claw Code: Insert @-Mention Reference"
      },
      {
        "command": "claw-vscode.installPlugin",
        "title": "Claw Code: Install Plugin"
      },
      {
        "command": "claude-code.acceptProposedDiff",
        "title": "Claw Code: Accept Proposed Changes",
        "enablement": "claw-vscode.viewingProposedDiff",
        "icon": "$(check)"
      },
      {
        "command": "claude-code.rejectProposedDiff",
        "title": "Claw Code: Reject Proposed Changes",
        "enablement": "claw-vscode.viewingProposedDiff",
        "icon": "$(discard)"
      },
      {
        "command": "claude-code.insertAtMentioned",
        "title": "Claw Code: Insert At-Mentioned"
      },
      {
        "command": "claw-vscode.showLogs",
        "title": "Claw Code: Show Logs"
      },
      {
        "command": "claw-vscode.openWalkthrough",
        "title": "Claw Code: Open Walkthrough"
      }
    ],
    "keybindings": [
      {
        "command": "claw-vscode.insertAtMention",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "claw-vscode.focus",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "!config.claudeCode.useTerminal && editorTextFocus"
      },
      {
        "command": "claw-vscode.blur",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "!config.claudeCode.useTerminal && !editorTextFocus"
      },
      {
        "command": "claw-vscode.editor.open",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape",
        "when": "!config.claudeCode.useTerminal"
      },
      {
        "command": "claw-vscode.terminal.open.keyboard",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape",
        "when": "config.claudeCode.useTerminal"
      },
      {
        "command": "claude-code.insertAtMentioned",
        "key": "cmd+alt+K",
        "mac": "cmd+alt+K",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K",
        "when": "editorTextFocus"
      },
      {
        "command": "claw-vscode.newConversation",
        "key": "cmd+n",
        "mac": "cmd+n",
        "win": "ctrl+n",
        "linux": "ctrl+n",
        "when": "config.claudeCode.enableNewConversationShortcut && (activeWebviewPanelId == 'clawVSCodePanel' || (claw-vscode.sideBarActive && !editorFocus && !panelFocus))"
      },
      {
        "command": "claw-vscode.reopenClosedSession",
        "key": "cmd+shift+t",
        "mac": "cmd+shift+t",
        "win": "ctrl+shift+t",
        "linux": "ctrl+shift+t",
        "when": "config.claudeCode.enableReopenClosedSessionShortcut && claw-vscode.lastClosedWasSession"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claw-sidebar",
          "title": "Claw Code",
          "icon": "resources/clawd.svg",
          "when": "claw-code:doesNotSupportSecondarySidebar"
        },
        {
          "id": "claw-sessions-sidebar",
          "title": "Claw Code",
          "icon": "resources/clawd.svg",
          "when": "claw-vscode.sessionsListEnabled"
        }
      ],
      "secondarySidebar": [
        {
          "id": "claw-sidebar-secondary",
          "title": "Claw Code",
          "icon": "resources/clawd.svg",
          "when": "!claw-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "claw-sidebar": [
        {
          "type": "webview",
          "id": "clawVSCodeSidebar",
          "name": "Claw Code",
          "when": "claw-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claw-sidebar-secondary": [
        {
          "type": "webview",
          "id": "clawVSCodeSidebarSecondary",
          "name": "Claw Code",
          "when": "!claw-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claw-sessions-sidebar": [
        {
          "type": "webview",
          "id": "clawVSCodeSessionsList",
          "name": "",
          "when": "claw-vscode.sessionsListEnabled"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "claude-code-walkthrough",
        "title": "Get started with Claude Code",
        "description": "Learn how to use Claude Code to write, edit, and understand your code.",
        "steps": [
          {
            "id": "welcome",
            "title": "Your AI coding partner",
            "description": "Claude Code helps you write, edit, and understand code right in VS Code.",
            "media": {
              "markdown": "resources/walkthrough/step1.md"
            }
          },
          {
            "id": "open-claude",
            "title": "Open Claude Code",
            "description": "Click the orange Claude icon in the top right corner, or press Ctrl+Escape (Cmd+Escape on Mac) to start a conversation.",
            "media": {
              "markdown": "resources/walkthrough/step2.md"
            },
            "completionEvents": [
              "onCommand:claw-vscode.sidebar.open",
              "onCommand:claw-vscode.editor.open"
            ]
          },
          {
            "id": "chat",
            "title": "Chat with Claude",
            "description": "Type a message and press Enter. Ask questions, request changes, or get help understanding your code. Use @ to mention files for context, or select code first to ask about it.",
            "media": {
              "markdown": "resources/walkthrough/step3.md"
            }
          },
          {
            "id": "sessions",
            "title": "Past conversations",
            "description": "Click the Past Conversations button at the top or type /resume to browse past sessions. You can start a new conversation anytime by clicking the New Chat button.",
            "media": {
              "markdown": "resources/walkthrough/step4.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claw-vscode.acceptProposedDiff",
          "when": "claw-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "claw-vscode.rejectProposedDiff",
          "when": "claw-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "claude-code.acceptProposedDiff",
          "when": "claw-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "claude-code.rejectProposedDiff",
          "when": "claw-vscode.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "claw-vscode.editor.openLast",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation"
        },
        {
          "command": "claw-vscode.terminal.open",
          "when": "config.claudeCode.useTerminal",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "claw-vscode.update",
          "when": "claw-vscode.updateSupported"
        },
        {
          "command": "claw-vscode.editor.openLast",
          "when": "false"
        },
        {
          "command": "claw-vscode.primaryEditor.open",
          "when": "claw-vscode.primaryEditorEnabled"
        },
        {
          "command": "claw-vscode.createWorktree",
          "when": "claw-vscode.createWorktreeEnabled"
        },
        {
          "command": "claw-vscode.blur",
          "when": "false"
        },
        {
          "command": "claw-vscode.newConversation",
          "when": "false"
        },
        {
          "command": "claude-code.insertAtMentioned",
          "when": "config.claudeCode.useTerminal"
        },
        {
          "command": "claw-vscode.insertAtMention",
          "when": "!config.claudeCode.useTerminal"
        },
        {
          "command": "claw-vscode.installPlugin",
          "when": "claw-vscode.updateSupported"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Untrusted workspaces are not supported"
    }
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0"
  }
}
